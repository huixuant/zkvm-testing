diff --git a/compiler/rustc_const_eval/src/interpret/cast.rs b/compiler/rustc_const_eval/src/interpret/cast.rs
index 643a5805019..83860806d7b 100644
--- a/compiler/rustc_const_eval/src/interpret/cast.rs
+++ b/compiler/rustc_const_eval/src/interpret/cast.rs
@@ -353,7 +353,33 @@ fn cast_from_float<F>(&self, f: F, dest_ty: Ty<'tcx>) -> Scalar<M::Provenance>
                     Scalar::from_f16(self.adjust_nan(f.convert(&mut false).value, &[f]))
                 }
                 FloatTy::F32 => {
-                    Scalar::from_f32(self.adjust_nan(f.convert(&mut false).value, &[f]))
+                    let res: Single = f.convert(&mut false).value;
+                    // ---- instrumentation (rustc-113407) -----------------------------
+                    // Only f64 -> f32 narrowing is affected (the subnormal/underflow
+                    // path in rustc_apfloat's convert). Gate on that, then compare the
+                    // apfloat result against the HOST's own f64->f32 cast, which is
+                    // correctly-rounded ground truth. 
+                    if std::mem::size_of::<F>() == std::mem::size_of::<Double>() {
+                        // source is f64: reconstruct host f64 from its bits
+                        let src_bits = f.to_bits() as u64;
+                        let host_ref: u32 = (f64::from_bits(src_bits) as f32).to_bits();
+                        let apf_bits: u32 = res.to_bits() as u32;
+                        if apf_bits != host_ref {
+                            if let Some(path) = std::env::var_os("MISCOMP_LOG") {
+                                if let Ok(mut file) = std::fs::OpenOptions::new()
+                                    .create(true).append(true).open(&path)
+                                {
+                                    use std::io::Write;
+                                    let _ = writeln!(file,
+                                        "MISCOMP rustc-113407 triggered: const-eval f64->f32 \
+                                         narrowing disagrees with host: src=0x{:016x} \
+                                         apfloat=0x{:08x} host=0x{:08x}",
+                                        src_bits, apf_bits, host_ref);
+                                }
+                            }
+                        }
+                    }
+                    Scalar::from_f32(self.adjust_nan(res, &[f]))
                 }
                 FloatTy::F64 => {
                     Scalar::from_f64(self.adjust_nan(f.convert(&mut false).value, &[f]))
