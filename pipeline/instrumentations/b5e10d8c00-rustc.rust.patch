#   ./x build --stage 1 compiler
#   rustup toolchain link b5e10d8c00-rustc build/x86_64-unknown-linux-gnu/stage1
#
# Verify the detector is live:
#   MISCOMP_LOG=/tmp/m.log ZEROOS_GUEST_TOOLCHAIN=b5e10d8c00-rustc <build a guest>
#   grep -c '^MISCOMP rustc-143491 triggered' /tmp/m.log
# ============================================================================
diff --git a/compiler/rustc_mir_transform/src/copy_prop.rs b/compiler/rustc_mir_transform/src/copy_prop.rs
index fe78a104fa0..049cb5913e0 100644
--- a/compiler/rustc_mir_transform/src/copy_prop.rs
+++ b/compiler/rustc_mir_transform/src/copy_prop.rs
@@ -2,7 +2,10 @@
 use rustc_index::bit_set::DenseBitSet;
 use rustc_middle::mir::visit::*;
 use rustc_middle::mir::*;
+use rustc_middle::ty::print::{with_crate_prefix, with_no_trimmed_paths};
 use rustc_middle::ty::TyCtxt;
+use rustc_middle::ty::{self};
+use rustc_span::def_id::LOCAL_CRATE;
 use tracing::{debug, instrument};
 
 use crate::ssa::SsaLocals;
@@ -40,6 +43,29 @@ fn run_pass(&self, tcx: TyCtxt<'tcx>, body: &mut Body<'tcx>) {
         for (local, &head) in ssa.copy_classes().iter_enumerated() {
             if local != head {
                 storage_to_remove.insert(head);
+                if ssa.borrowed_locals().contains(local) {
+                    use std::io::Write;
+                    if let Some(path) = std::env::var_os("MISCOMP_LOG") {
+                        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+                            let def_id = body.source.def_id();
+                            let args = ty::GenericArgs::identity_for_item(tcx, def_id);
+                            let mut fn_path = with_crate_prefix!(
+                                with_no_trimmed_paths!(
+                                    tcx.def_path_str_with_args(def_id, args)
+                                )
+                            );
+
+                            let crate_name = tcx.crate_name(LOCAL_CRATE).to_string();
+                            fn_path = fn_path.replace(
+                                "crate::",
+                                &format!("{crate_name}::")
+                            );
+
+                            let _ = writeln!(f, "MISCOMP rustc-143491 triggered path={} def={:?} local={:?} head={:?}",
+                                            fn_path, def_id, local, head);
+                        }
+                    }
+                }
             }
         }
 
